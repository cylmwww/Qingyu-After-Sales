# 占位配置，不含真实模型密钥。不要覆盖已有 .env。
RAG_MODE=real
DATABASE_URL=postgresql://rag:rag-local-only@127.0.0.1:5433/rag
POSTGRES_PASSWORD=rag-local-only
# Docker 前端通过内网代理访问后端，必须设置令牌；页面填写同一值。
API_ACCESS_TOKEN=replace-with-a-long-local-access-token
THINKING_MODEL_PROVIDER=your-third-party-provider
THINKING_MODEL_BASE_URL=https://your-provider.example/v1
THINKING_MODEL_API_KEY=
THINKING_MODEL_ID=deepseek-v4.1-flash
THINKING_MODEL_ENABLE_THINKING=false
# 生成角色独立配置，不继承规划等角色的思考开关。
GENERATION_ENABLE_THINKING=false
# stream=false返回完整SSE可用json-or-sse-v1；需要stream=true的供应商用sse-json-v1。
# 空帧/截断仍失败，协议选择会保存到请求快照。
STRUCTURED_RESPONSE_PROTOCOL=strict-json-v1
EMBEDDING_MODEL_PROVIDER=aliyun
EMBEDDING_MODEL_BASE_URL=https://your-embedding-provider.example/compatible-mode/v1
EMBEDDING_MODEL_API_KEY=
EMBEDDING_MODEL_ID=text-embedding-v4
EMBEDDING_MODEL_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
# 可选：版本化配置优先于上述 Embedding 模型/维度和分块环境值。
# 默认省略此项，继续第二阶段 rule-v1 配置；接口地址和密钥仍从环境读取。
# INDEX_CONFIG_PATH=configs/indexes/stage2-baseline.v1.0.0.json
MODEL_TIMEOUT_SECONDS=30
EMBEDDING_TIMEOUT_SECONDS=15
REQUEST_TIMEOUT_SECONDS=120
TRACE_RETENTION_DAYS=30
# 召回配置省略时保留原纯向量 Top20/Top6；BM25/双路需先为指定索引构建派生产物。
# RETRIEVAL_CONFIG_PATH=configs/retrieval/r3-hybrid-rrf.v1.0.0.json
# 独立重排填写纯 URL，不带 POST 前缀；不自动借用 Embedding 地址或密钥。
# 北京 qwen3-rerank 示例（需替换业务空间，其他模型/地域按服务商说明）：
# RERANK_MODEL_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
RERANK_MODEL_PROVIDER=your-rerank-provider
RERANK_MODEL_URL=
RERANK_MODEL_API_KEY=
RERANK_MODEL_ID=qwen3-rerank
RERANK_TIMEOUT_SECONDS=15
# 可选查询/上下文/生成配置；省略保留第四阶段基线。
# ANSWER_CONFIG_PATH=configs/answers/q2-parent-related.v1.0.0.json
# 只读业务Agent：省略配置为正常auto，实验预设固定fast/fixed/dynamic。
# 原单轮 /api/chat 不使用此执行策略，原检索和答案配置仍沿用。
# AGENT_CONFIG_PATH=configs/agents/auto.v1.1.0.json
AGENT_CUSTOMER_ID=CUST-001
BUSINESS_SNAPSHOT_ID=SNAP-DEMO-20261009
# 可选前置检查/后置审核/纠错；省略或off预设保留第六阶段Agent基线。
# 原单轮 /api/chat 不进入审核；仅修改答案需要后置，定向补查需dynamic/auto。
# REVIEW_CONFIG_PATH=configs/reviews/limited-correction.v1.0.0.json
