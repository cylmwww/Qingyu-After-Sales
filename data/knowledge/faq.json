    {
      "id": "FAQ-001",
      "version": "1.1.0",
      "question": "无理由退货的七天从哪一刻开始算？",
      "paraphrases": [
        "是购买后七天还是收货后七天？",
        "正好在签收七天的截止时刻申请可以吗？"
      ],
      "answer": "青屿示例店的无理由退货时间条件从有证据的签收时刻起算连续7×24小时，申请时刻不晚于截止时刻，恰好在截止边界也包含在内。尚未签收或签收、申请时刻缺失时，不能确定窗口，尤其不能凭购买日计算。满足七日窗口只是时间条件，还要共同满足相应品类政策；定制商品仍不支持无理由退货。 超出七日正常窗口后可生成交接摘要供人工裁量；最终是否受理未知，不能保证可退，也不能仅因超期断言人工必然拒绝。",
      "applicability": {
        "category_ids": [
          "apparel_footwear",
          "digital_accessories",
          "customized"
        ],
        "conditions": [
          {
            "field": "return_reason",
            "op": "eq",
            "value": "no_reason"
          }
        ],
        "effective_from": "2026-01-01T00:00:00+08:00",
