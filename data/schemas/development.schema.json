{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "development.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "schema_version": {
      "enum": [
        "1.1.0",
        "1.1.1"
      ]
    },
    "split": {
      "const": "development"
    },
    "review_status": {
      "$ref": "common.schema.json#/$defs/review_status"
    },
    "group_ids": {
      "type": "array",
      "items": {
        "enum": [
          "standard_faq",
          "long_tail",
          "multi_document",
          "dependent_multihop",
          "multi_turn",
          "unanswerable"
        ]
      },
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "version": {
            "$ref": "common.schema.json#/$defs/version"
          },
          "group_id": {
            "enum": [
              "standard_faq",
              "long_tail",
              "multi_document",
              "dependent_multihop",
              "multi_turn",
              "unanswerable"
            ]
          },
          "family_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "business_snapshot_ref": {
            "$ref": "common.schema.json#/$defs/ref"
          },
          "request_context": {
            "type": "object",
            "properties": {
              "shop_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "customer_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "evaluated_at": {
                "$ref": "common.schema.json#/$defs/timestamp"
              }
            },
            "required": [
              "shop_id",
              "customer_id",
              "evaluated_at"
            ],
            "additionalProperties": false
          },
          "fixture_refs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/ref"
            },
            "minItems": 0
          },
          "turns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "version": {
                  "$ref": "common.schema.json#/$defs/version"
                },
                "role": {
                  "enum": [
                    "user",
                    "expected_assistant"
                  ]
                },
                "at": {
                  "$ref": "common.schema.json#/$defs/timestamp"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "facts": {
                  "type": "object"
                },
                "expected_action": {
                  "anyOf": [
                    {
                      "$ref": "common.schema.json#/$defs/action"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "invalidates": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/ref"
                  },
                  "minItems": 0
                },
                "business_snapshot_ref": {
                  "$ref": "common.schema.json#/$defs/ref"
                },
                "invalidated_fields": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "version",
                "role",
                "at",
                "text",
                "facts",
                "expected_action",
                "invalidates"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "any_of": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/ref"
                  },
                  "minItems": 1
                },
                "visibility": {
                  "enum": [
                    "assistant",
                    "evaluator_only"
                  ]
                },
                "available_from_turn_id": {
                  "$ref": "common.schema.json#/$defs/id"
                }
              },
              "required": [
                "id",
                "description",
                "any_of",
                "visibility",
                "available_from_turn_id"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "expected_conclusions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_group_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "expected_values": {
                  "type": "object"
                },
                "value_checks": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string",
                            "minLength": 1
                          },
                          "kind": {
                            "const": "record_field"
                          },
                          "source_ref": {
                            "$ref": "common.schema.json#/$defs/ref"
                          },
                          "source_field": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "key",
                          "kind",
                          "source_ref",
                          "source_field"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "key": {
                            "enum": [
                              "merchandise_refund_cents",
                              "outbound_shipping_refund_cents",
                              "total_estimated_cents"
                            ]
                          },
                          "kind": {
                            "const": "refund_estimate"
                          },
                          "order_ref": {
                            "$ref": "common.schema.json#/$defs/ref"
                          },
                          "return_reason": {
                            "enum": [
                              "no_reason",
                              "quality"
                            ]
                          },
                          "selections": {
                            "type": "array",
                            "items": {
                              "$ref": "common.schema.json#/$defs/selection"
                            },
                            "minItems": 1
                          },
                          "gift_returned_line_ids": {
                            "type": "array",
                            "items": {
                              "$ref": "common.schema.json#/$defs/id"
                            },
                            "minItems": 0
                          }
                        },
                        "required": [
                          "key",
                          "kind",
                          "order_ref",
                          "return_reason",
                          "selections",
                          "gift_returned_line_ids"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "minItems": 0
                },
                "applies_after_turn_id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "assistant_evidence_group_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "text",
                "evidence_group_ids",
                "expected_values",
                "applies_after_turn_id",
                "assistant_evidence_group_ids"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "allowed_actions": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/action"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "forbidden_errors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "hop_dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "minItems": 0,
                  "uniqueItems": true
                },
                "operation": {
                  "$ref": "common.schema.json#/$defs/action"
                },
                "input_bindings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "parameter": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_step_id": {
                        "$ref": "common.schema.json#/$defs/id"
                      },
                      "source_field": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "parameter",
                      "source_step_id",
                      "source_field"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                },
                "output_fields": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "depends_on",
                "operation",
                "input_bindings",
                "output_fields"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "review_status": {
            "$ref": "common.schema.json#/$defs/review_status"
          }
        },
        "required": [
          "id",
          "version",
          "group_id",
          "family_id",
          "tags",
          "description",
          "business_snapshot_ref",
          "request_context",
          "fixture_refs",
          "turns",
          "required_evidence",
          "expected_conclusions",
          "allowed_actions",
          "forbidden_errors",
          "hop_dependencies",
          "review_status"
        ],
        "additionalProperties": false
      },
      "minItems": 30,
      "maxItems": 30
    }
  },
  "required": [
    "id",
    "version",
    "schema_version",
    "split",
    "review_status",
    "group_ids",
    "cases"
  ],
  "additionalProperties": false
}
