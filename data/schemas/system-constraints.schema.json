{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "系统静态约束",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.1.0",
        "1.1.1"
      ]
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "review_status": {
      "$ref": "common.schema.json#/$defs/review_status"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "version": {
            "$ref": "common.schema.json#/$defs/version"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "review_status": {
            "$ref": "common.schema.json#/$defs/review_status"
          }
        },
        "required": [
          "id",
          "version",
          "title",
          "statement",
          "source_path",
          "review_status"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "review_status",
    "items"
  ],
  "additionalProperties": false
}
